# ==============================================================================
# NEBOSH/IOSH Remote Proctoring Platform - Production Backend Environment
# ==============================================================================

# --- Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=proctoring
# Backend connection string (uses the Docker network hostname 'postgres')
DATABASE_URL=postgresql+asyncpg://postgres:generate_a_secure_postgres_password_here@postgres:5432/proctoring

# --- Redis Configuration ---
# Uses the Docker network hostname 'redis'
REDIS_URL=redis://redis:6379/0

# --- S3 / Object Storage Configuration ---
# Option A: Self-hosted MinIO (Default in docker-compose.prod.yml)
S3_BUCKET=nebosh-proctoring
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# Public URL of the same store, used to sign snapshot/KYC download links that
# partners and reviewers open in a browser (proxy it via Nginx, see nginx/).
S3_PUBLIC_ENDPOINT_URL=https://files.yourdomain.com
S3_USE_KMS_ENCRYPTION=false
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secure_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password

# Option B: Real AWS S3 / Wasabi / DigitalOcean Spaces / Cloudflare R2
# (Uncomment and replace if using external cloud storage)
# S3_BUCKET=your-cloud-bucket-name
# S3_REGION=me-central-1
# S3_ENDPOINT_URL=
# S3_USE_KMS_ENCRYPTION=true
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# --- Security & JWT ---
# Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_64_character_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Max lifetime a partner may request for a session token (minutes)
SESSION_TOKEN_MAX_MINUTES=240

# --- Public ingress ---
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Used by the `cloudflared` service (compose profile "tunnel").
TUNNEL_TOKEN=
# Header with the real client IP: x-real-ip (nginx) or cf-connecting-ip (Cloudflare)
CLIENT_IP_HEADER=cf-connecting-ip

# --- Partner API ---
# Public Swagger/ReDoc/openapi.json — keep off in production; share the exported spec instead
API_DOCS_ENABLED=false
# Optional shared password (no username) in front of /docs, /redoc, /openapi.json
API_DOCS_PASSWORD=
# Per-organization limit on API-key calls (requests per minute)
API_KEY_RATE_LIMIT_PER_MINUTE=600
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_ATTEMPTS=8

# --- Capacity (see "Capacity & sizing" in README) ---
# Keep UVICORN_WORKERS x INFERENCE_THREADS x ONNX_INTRA_OP_THREADS ~= CPU cores.
# Example below is for an 8-core host (~30-40 learners at one frame / 7 s).
UVICORN_WORKERS=1
INFERENCE_THREADS=4
ONNX_INTRA_OP_THREADS=2

# --- Background jobs (run inside the API workers) ---
BACKGROUND_JOBS_ENABLED=true
# Active sessions with no frames/events for this long become "abandoned"
SESSION_IDLE_TIMEOUT_MINUTES=30
# Per-frame metadata + delivered webhooks are deleted after this many days
SESSION_FRAMES_RETENTION_DAYS=30

# --- Observability ---
# Error tracking (leave empty to disable). No inline comments after values in
# this file — Docker reads "KEY=value  # note" as the literal value.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- CORS Settings ---
# Comma-separated list of origins allowed to call the API from web browsers
# Example: https://exam.yourdomain.com,https://lms.savefast.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# --- Proctoring & ML Inference Settings ---
FACE_MATCH_THRESHOLD=0.38
HOLD_ID_MATCH_THRESHOLD=0.22
LIVENESS_THRESHOLD=0.5
PERSON_CONF_THRESHOLD=0.5
VIOLATION_DEBOUNCE_FRAMES=2
HEAD_YAW_THRESHOLD=25.0
HEAD_PITCH_DOWN_THRESHOLD=20.0
HEAD_PITCH_UP_THRESHOLD=30.0
GAZE_DEVIATION_THRESHOLD=0.20
MAX_FRAME_DIM_PX=640

# --- Host Port Binding ---
# 127.0.0.1:8000 binds to localhost only (recommended when using Nginx / Caddy on host)
# 0.0.0.0:8000 exposes directly to internet (only if not using reverse proxy)
HOST_PORT=127.0.0.1:8000
